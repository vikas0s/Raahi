# ==============================================================================
# Raahi Multi-Modal Mobility Platform Configuration
# ==============================================================================

# MongoDB Persistent Transit Database (https://www.mongodb.com/)
# Supports local standalone MongoDB and MongoDB Atlas clusters
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=raahi
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# Relational / Persistent Database (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///raahi_transit.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Sarvam AI API Configuration (https://dashboard.sarvam.ai/)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b

# Google Gemini API Configuration (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Delhi Transport Open Data (OTD) API Key
OTD_DELHI_API_KEY=your_otd_delhi_api_key_here

# Indian Railways & Suburban Rail Telemetry (Optional)
# https://railradar.in/api/v1
RAILRADAR_API_KEY=your_railradar_api_key_here
